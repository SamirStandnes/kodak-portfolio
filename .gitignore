data/new_raw_transactions/nordnet/*
!data/new_raw_transactions/nordnet/.gitkeep
data/new_raw_transactions/saxo/*
!data/new_raw_transactions/saxo/.gitkeep

# Virtual environment
.venv/
env/
venv/

