# Template for Streamlit Community Cloud secrets.
#
# Do NOT put real values here or commit a filled-in secrets.toml.
# On Streamlit Cloud: app → Settings → Secrets, paste the three keys below.
# Streamlit exposes top-level secrets as environment variables, which is how
# the existing adapter system (common.py / config_adapter.py) picks them up —
# no code change needed.

# Postgres connection string.
#  - Intermediate test: use the existing Heroku value
#      heroku config:get DATABASE_URL -a <your-heroku-app>
#  - Final: use the Neon connection string (Pooled connection, includes ?sslmode=require)
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Login password for the hosted dashboard (presence of this enables the auth gate).
DASHBOARD_PASSWORD = "choose-a-password"

# Base currency (matches config.yaml locally).
BASE_CURRENCY = "NOK"
